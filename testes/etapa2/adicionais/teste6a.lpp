program teste6a
begin
a, b = int;
media = float;
opcao = char;
read(a);
b = -a + 2 * 3 % 2;
media = (a + b) / 2;
opcao = 'S';
if ((a >= b) && !(a == 0)) || (b != 1) then
  write("primeiro ramo")
else
  write(media)
end;
while a < 10 do
  a = a + 1
end;
repeat
  a = a - 1
until a <= 0;
write(opcao)
end.
